# BOA config: the project's settings, read by every BOA tool, hook and template (.boa/config.env).
# Written by `boa install` from this template when the project has none; the agent fills it in (a project-wiring
# step, references/project-wiring.md "Config"), asks the user what it cannot know or decide, then runs
# `boa install` again. Install refuses while a required value (marked REQUIRED) is empty or invalid.
# Format: KEY='value' lines, single-quoted (sourcing the file in a POSIX shell executes nothing; the tools parse it
# without executing anything). Paths use `/` on every platform (Windows: `C:/...`). Comments start with #.

# --- the project ------------------------------------------------------------------------------------------------
# REQUIRED. The project's name (1-80 characters) and its slug (lowercase letters, digits and -, 1-40, no edge -).
BOA_PROJECT_NAME=''
BOA_PROJECT_SLUG=''
# The language of replies to the user and of the documentation (language codes, e.g. en, it).
BOA_REPLY_LANGUAGE='en'
BOA_DOC_LANGUAGE='en'
# greenfield | brownfield | refactor (references/modes/).
BOA_MODE='greenfield'
# Where BOA's rules go: full = the whole of them as a marked block of AGENTS.md (the default; greenfield); pointer =
# their own versioned file docs/boa-rules.md, and AGENTS.md gets only a short marked block pointing to it, which
# says the project's own rules win where they conflict until the rules reconciliation is done. Suggest pointer for
# brownfield and refactor when AGENTS.md already holds the project's rules, and ask the user.
BOA_AGENTS_BLOCK='full'
# The stack plug-in under .boa/stack/: `generic` is the only template BOA ships; the agent adapts it to the project.
BOA_STACK='generic'
# The agent runtime: its id as its profile in references/runtimes.md names it, or other (a runtime without a profile).
BOA_RUNTIME='other'
# REQUIRED. The model roster (agent frontmatter): the runtime's frontier model and the one just below it, chosen
# with the user (references/runtimes.md).
BOA_MODEL_FRONTIER=''
BOA_MODEL_MID=''
# REQUIRED. The absolute path of a working Python 3.11+ (`<path> -I -c "import json"` must run): every hook calls it.
BOA_PYTHON=''
# Optional: the first install's date (YYYY-MM-DDTHH:MM:SSZ). Without it, boa install keeps the date the project's
# rendered files already carry, so a reinstall (also on a fresh clone) never changes them.
# BOA_INSTALL_DATE=''

# --- git, lanes and the lead --------------------------------------------------------------------------------------
# The branch of a task: the tokens <ms> <task> <slug>; <task> and <slug> are required; never matches the main branch.
BOA_BRANCH_GRAMMAR='m<ms>/<task>-<slug>'
BOA_MAIN_BRANCH='main'
BOA_REMOTE='origin'
# REQUIRED. The lane worktrees: absolute, or relative to the main checkout starting with ../ (outside the
# repository), e.g. ../<the slug>-wt.
BOA_WT_DIR=''
# The lead's working dir (git-excluded), a relative path inside the repository.
BOA_LEAD_DIR='.lead'
# REQUIRED. The agents' scratch root: an absolute path at least two levels deep, never containing the project
# (e.g. the runtime's own temp dir for this project, references/runtimes.md).
BOA_SCRATCH_ROOT=''
# The layout of the task entries under the scratch root, as a relative glob, its last component the entry
# <task>-<role> (your runtime's profile in references/runtimes.md gives it; default *: the entries directly under the
# root, a deeper layout e.g. */<dir>/*). The guards never let anyone delete a level above the entries (shared by every
# lane); a value that is not a relative glob refuses every call until it is fixed (and no agent binding is recorded
# meanwhile: sub-agents spawned then stay unbound after the fix). Upgrading: a runtime whose sessions nest their
# scratch dirs needs this key set (the default * is the flat layout).
BOA_SCRATCH_GLOB='*'
# The top-level names in the main checkout that hold the agent runtime's own configuration (its settings directory,
# its instruction file), space-separated, as your runtime profile in references/runtimes.md names them, plus those of
# every other runtime that has worked on the project. Top-level names only (a name holding / is dropped). The guard
# refuses shell writes and deletions of them in the main checkout, and only that: not git verbs, not lane worktrees,
# not the lead's file-editing tools. Empty until the runtime is wired.
BOA_RUNTIME_CONFIG=''
# The prefix of the project's throwaway resources and (REQUIRED) the label key that ties them to a lane, e.g.
# com.<the slug>.lane.
BOA_NAME_PREFIX='boa-'
BOA_LABEL_KEY=''
# The prefix of BOA's environment variables (e.g. the lead's logged guard override <prefix>GUARD_LEAD_VERIFIED).
BOA_ENV_PREFIX='BOA_'
# The forge: github | gitlab | none, and the repository (owner/repo; empty with none) (references/forge.md).
BOA_FORGE='none'
BOA_FORGE_REPO=''

# --- lane admission (lead-status) ----------------------------------------------------------------------------------
# How many lanes run at once, the memory one lane needs, the free memory and the load under which no lane starts
# (empty load = no load limit).
BOA_LANE_CAP='2'
BOA_LANE_MEM_MB='2560'
BOA_ADMIT_MIN_MEM_MB='2048'
BOA_ADMIT_MAX_LOAD=''

# --- discipline values ---------------------------------------------------------------------------------------
# Values the rules and templates quote; the project's own checks read them once the agent wires them
# (references/project-wiring.md): whether heavy runs go to a remote runner (off | on), the gate's time budget (s)
# and the share (%) above which one suite dominates a gate step, the project's disk warning and ceiling (MB).
BOA_RUNNER='off'
BOA_GATE_BUDGET_S='1200'
BOA_DOMINANCE_PCT='70'
BOA_DISK_WARN_MB='14336'
BOA_DISK_HARD_MB='20480'
# The agent's context size (tokens) at which the lead starts a FRESH agent of the same role instead of resuming it
# for a bounce or a next round (the agent lifecycle, 09 section 5.3). The size trigger is the LOWER of this bound and
# about half of the model's context window (recorded in the capabilities record): per-turn cost grows with the
# context long before a large window is half full, so a window of a million tokens would otherwise trigger far too
# late. The round count and the wait past the prompt-cache lifetime are triggers too.
# WHEN to set it: at the capability self-assessment (the moment each role's model and context window are recorded),
# at every re-wiring or model change, and whenever the user asks. HOW: keep the default unless (a) half of the
# smallest context window among the roles' models is lower (use that), (b) the user states a cost or speed preference
# (lower it for cheaper turns, raise it, never above half the window, for fewer re-briefs), or (c) measured data of
# the usage record shows the re-brief cost above the carry cost, or the reverse. It is a project decision: write it
# here, add a one-line decision entry naming the reason, and tell the user the value in one line; no answer from the
# user keeps the default.
BOA_AGENT_FRESH_TOKENS='200000'

# --- where things are -------------------------------------------------------------------------------------------
# BOA's machine-local logs and state: new subdirectories of .boa/ (git-ignored).
BOA_LOG_DIR='.boa/logs'
BOA_STATE_DIR='.boa/state'
BOA_PLAN_FILE='memory-bank/03-IMPLEMENTATION-PLAN.md'
BOA_SPEC_FILE='memory-bank/02-SPECIFICATIONS.md'
BOA_DECISIONS_FILE='memory-bank/06-DECISIONS.md'
BOA_REGISTER_FILE='memory-bank/04-ARCHITECTURE.md'
BOA_ACTIVE_CONTEXT='memory-bank/active-context.md'
BOA_FEATURES_FILE='docs/parity/features.toml'
BOA_METALEARNING_FILE='memory-bank/10-METALEARNING.md'
BOA_PLAN_CHECKLIST_HEAD='## Coverage checklist'
# The project's test files for the traceability check (space-separated globs) and the ones to leave out. Empty
# until the agent sets the project's own layout at wiring (project-wiring "stack plug-in"); while it is empty the
# traceability check reports that no test can trace a feature.
BOA_TEST_GLOBS=''
BOA_TEST_EXCLUDES=''
# lane-worktree: dependency dirs shared into a lane (space-separated), the ones copied privately instead, and the
# paths a lane's sparse checkout leaves out.
BOA_DEP_DIRS=''
BOA_DEP_PRIVATE=''
BOA_SPARSE_EXCLUDES=''
