# shellcheck shell=sh disable=SC2034  # the variables are read by the stack's tools, which source this file
# BOA stack plug-in "generic": the settings of a project whose stack has no dedicated plug-in yet. Installed as
# .boa/stack/plugin.env; the agent adapts it to the project at bootstrap (it is project code from then on).
# Sourced in POSIX sh by the stack's tools (and the project's gate, when it reads them): assignments only, no commands.
STACK_NAME=generic
# How the project's tests run, by configuration (read by test-runner.sh): one `<glob>=<command>` per line, `{}` = the
# test file, `{dir}` = its directory; the first match wins; shell suites (*.sh, *.bash) always run with bash. Shape:
#   <glob matching one kind of test file>=<the project's command that runs one such file> {}
#   <another glob>=<another command> {dir}
TEST_COMMANDS=''
# Heavy tests (the ones that need an external service): a runner that supports them takes `--heavy` and reads the
# container image of that service from here. The service and its image are the project's decision, made at bootstrap
# and recorded as an ADR; BOA names none and has no default, and the runner must refuse `--heavy` while this is empty.
# TEST_HEAVY_IMAGE='<image reference of the service the heavy tests need>'
# How many test files test-runner.sh takes per call (the project's gate calls it in chunks of this size).
TEST_RUNNER_MAX_FILES=50
